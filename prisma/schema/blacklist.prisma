model SubmissionClientLimit {
  clientId      String     @id
  lastAllowedAt DateTime
  rejectedAt    DateTime[]
  expiresAt     DateTime

  @@index([expiresAt])
  @@map("submission_client_limits")
}

model SubmissionNetworkLimit {
  ip         String     @id
  attemptsAt DateTime[]
  expiresAt  DateTime

  @@index([expiresAt])
  @@map("submission_network_limits")
}

enum BlacklistScope {
  browser
  network
  legacy
}

model SubmissionBlacklist {
  id             String           @id @default(cuid())
  scope          BlacklistScope   @default(browser)
  targetId       String
  ip             String
  isActive       Boolean          @default(true)
  endReason      String?
  expiresAt      DateTime?
  blacklistCount Int              @default(1)
  lastBlockedAt  DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  events         BlacklistEvent[]

  @@unique([scope, targetId])
  @@index([scope, isActive, expiresAt])
  @@index([isActive, createdAt])
  @@index([ip])
  @@map("ip_blacklist")
}

model BlacklistEvent {
  id          String              @id @default(cuid())
  blacklistId String
  blacklist   SubmissionBlacklist @relation(fields: [blacklistId], references: [id], onDelete: Restrict)
  ip          String
  createdAt   DateTime            @default(now())
  expiresAt   DateTime?
  endedAt     DateTime?
  endReason   String?
  revokedAt   DateTime?
  revokedBy   String?

  @@index([blacklistId, createdAt])
  @@index([ip])
  @@map("ip_blacklist_events")
}
