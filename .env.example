# Shared application variables. Replace placeholders for each environment.
# For Neon, use sslmode=verify-full in the URL to verify the server certificate
# and hostname explicitly. The localhost example below does not enable TLS.
DATABASE_URL=postgresql://user:password@localhost:5432/world_of_moments
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public recipient for error reports and client-account appeals.
NEXT_PUBLIC_ERROR_REPORT_EMAIL=

# Browser-visible CARTO basemap key, inlined at build time. Restrict it in CARTO.
NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=

# Existing weather variables are retained for configuration parity.
# The current Open-Meteo implementation does not read these variables or need a key.
WEATHER_API_KEY=
WEATHER_API_BASE=

# Required for CMS runtime in BOTH development and production.
# Generate a separate random secret (at least 32 characters) for each environment.
# Keep each environment's secret stable and shared across its server instances.
BETTER_AUTH_SECRET=

# Optional: defaults to NEXT_PUBLIC_APP_URL. Set only when an override is needed.
# CMS_AUTH_URL=http://localhost:3000

# Seed command only; not required for normal application startup.
# Set to worldofmoment for the requested initial admin account and run pnpm cms:seed.
# Reseeding never resets an existing account's password.
CMS_INITIAL_ADMIN_PASSWORD=

# Optional runtime origin override for client auth/thought mutations; defaults to NEXT_PUBLIC_APP_URL.
# SUBMISSION_PUBLIC_ORIGIN=http://localhost:3000

# Independent from BETTER_AUTH_SECRET; at least 32 random characters.
CLIENT_AUTH_SECRET=
# Resend sender must use a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=World of Moments <hello@your-domain.example>
# Create an invisible Turnstile widget restricted to your application hostnames.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: set the hosting timezone consistently on every app instance.
# TZ=Asia/Ho_Chi_Minh
